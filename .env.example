# Repose Environment Configuration
# Presage SmartSpectra API Key (obtain from https://physiology.presagetech.com/auth/register)
PRESAGE_API_KEY=your_presage_api_key_here

# Enable Simulated Signal Provider for local UI/Unit testing without camera (dev only)
# MUST BE false for live device testing and demo submission
ENABLE_SIMULATED_SIGNAL=false

